# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ── Groq ──────────────────────────────────────────────────────────────────────
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Qdrant Cloud ──────────────────────────────────────────────────────────────
# Create a free cluster at https://cloud.qdrant.io
QDRANT_URL=https://your-cluster-id.region.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=reds_striver_dsa

# ── Embedding Model (auto-downloaded on first run, no key needed) ─────────────
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
